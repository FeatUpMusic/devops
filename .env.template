# Database (PostgreSQL + pgvector)
DB_NAME=featup
DB_USER=user
DB_PASSWORD=password
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/featup

# MongoDB
SPRING_DATA_MONGODB_URI=mongodb://mongodb:27017/featup

# Redis
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Neo4j Graph Database
SPRING_NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Storage (MinIO)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=featup-audio

# Encryption Config
ENCRYPTION_KEY=my-super-secret-encryption-key-32

# Rate Limiting
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
